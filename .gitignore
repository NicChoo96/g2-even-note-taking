# Dependencies
node_modules/

# Build output
dist/
*.ehpk

# Env / secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Relay disk state (created at runtime by web/server/local-sse.mjs)
.g2-hub-state.json
# Local staging of the built glasses app (Docker builds its own copy)
glasses-dist/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vercel
.vercel/

# Generated QR code (prototype loading)
qr-prototype.png

# Relay auth store (session tokens + approved devices) — NEVER commit
.g2-hub-auth.json

# Relay secret store (LLM + web-search keys) — NEVER commit
.g2-hub-secrets.json
# The scheduled-agent clock: the RUN STATE is local, and the live schedule is a
# deployment's own business (the checked-in .example.json documents its shape).
.g2-agent-cron-state.json
.g2-agent-cron.json
# A paired-device credential minted by scripts/repair-agents.mjs. Never commit it.
.tmp-e2e-repair-device.txt

# Watchdog-sim test artifacts (generated/downloaded wav)
glasses/tools/*.wav

# python bytecode
__pycache__/
*.pyc
probe-result.txt
search-probe.txt

# Sweep scratch (sim-all.mjs / harness redirect targets)
.tmp-*
# The sweep report: stdout of `sim-all.mjs` redirected to a file, because the
# harnesses bail out when stdout is a pipe. It is a scratch copy of a report that
# can be regenerated any time, so it never belongs in a commit.
sweep.txt
glasses/sweep.txt

.tmp-e2e/
local/
ignore/