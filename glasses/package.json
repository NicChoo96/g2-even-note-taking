{
  "name": "g2-even-reality-hub-glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"fs.copyFileSync('app.json','dist/app.json')\"",
    "build:deploy": "tsc --noEmit && vite build --base=/glasses/ && node -e \"fs.copyFileSync('app.json','dist/app.json')\"",
    "preview": "vite preview",
    "simulate": "evenhub-simulator http://127.0.0.1:5175"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.14"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
