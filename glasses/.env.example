# URL of the SSE stream the glasses app connects to.
# Local dev (local SSE server from web/server/local-sse.mjs):
#   VITE_HUB_STREAM_URL=http://localhost:5174/api/stream?channel=hub
# Deployed Vercel:
#   VITE_HUB_STREAM_URL=https://<your-vercel-app>.vercel.app/api/stream?channel=hub
VITE_HUB_STREAM_URL=http://localhost:5174/api/stream?channel=hub
