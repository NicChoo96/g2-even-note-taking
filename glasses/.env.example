# URL of the SSE stream the glasses app connects to.
# Local dev (local SSE server from web/server/local-sse.mjs):
#   VITE_HUB_STREAM_URL=http://localhost:5198/api/stream?channel=hub
# Deployed Vercel / Railway:
#   VITE_HUB_STREAM_URL=https://<your-app>.example/api/stream?channel=hub
VITE_HUB_STREAM_URL=http://localhost:5198/api/stream?channel=hub

# Agents ride a SEPARATE channel so agent configs + transcripts never bloat the
# hub channel. Without this the app falls back to same-origin /api/stream.
VITE_HUB_AGENTS_URL=http://localhost:5198/api/stream?channel=agents

# NOTE: never put API keys here. Vite INLINES every VITE_* value into the public
# bundle, which the glasses download. All keys live server-side — see
# web/.env.example and the relay's own .env.local.
