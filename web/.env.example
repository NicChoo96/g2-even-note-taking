# ─────────────────────────────────────────────────────────────────────────────
# Relay configuration — copy this file to `.env.local` and fill in your keys.
#
#   cp web/.env.example web/.env.local
#
# `.env.local` is GITIGNORED. Real process env vars always win over this file,
# so a host (Railway / Render / Docker) can override anything without editing
# it. Nothing here is ever sent to a client or inlined into a bundle — keys
# stay inside the relay process.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5198

# ── Agents: LLM provider (OpenRouter) ────────────────────────────────────────
# https://openrouter.ai/keys — use free + tool-capable models only.
# NOTE: models must also pass your account's data policy / ZDR guardrail, or
# every run fails with "0 endpoints out of 1 requested are available".
# Working on this account: inclusionai/ling-3.0-flash-sante:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
# Optional OpenRouter attribution headers (required for free-tier routing).
OPENROUTER_REFERER=https://github.com/NicChoo96/g2-even-note-taking
OPENROUTER_TITLE=G2 Even Reality Hub

# ── Agents: web-search tool (Tavily OR Brave Search) ────────────────────────
# The tool is one and the same — the model always calls `web_search` — so pick a
# backend here (or on the Settings page) without touching any agent.
#   SEARCH_PROVIDER=tavily|brave   (leave blank to auto-pick: Tavily if its key
#                                   is set, otherwise Brave)
#   WEB_SEARCH_DEPTH=basic|advanced   default depth for both backends
SEARCH_PROVIDER=
WEB_SEARCH_DEPTH=basic
# Tavily — https://app.tavily.com/home
TAVILY_API_KEY=
# Brave Search — https://api-dashboard.search.brave.com/ (LLM Context plan)
BRAVE_SEARCH_API_KEY=

# ── Jarvis document store (optional — the Files page stays empty without it) ─
# Where an agent or Jarvis PUBLISHES an HTML document, and where the Files page
# reads it back from. The credential lives here and NEVER reaches a browser: the
# relay proxies every call, because the gateway allows no cross-origin requests
# and its own URLs refuse to be framed (`X-Frame-Options: SAMEORIGIN`).
#
#   JARVIS_FILE_URL=http://host:port    the gateway root (default below)
#   JARVIS_FILE_USER + JARVIS_FILE_PWD  password login — the session renews its
#                                       own short-lived tokens automatically
#   JARVIS_FILE_API_KEY=jvk_…           a pre-minted key INSTEAD of the pair.
#                                       Preferred for a server: it has no
#                                       session, so nothing can expire or need
#                                       a refresh token to rotate.
# Providing both is fine — the API key wins.
JARVIS_FILE_URL=http://167.172.77.136
JARVIS_FILE_USER=
JARVIS_FILE_PWD=
JARVIS_FILE_API_KEY=

# ── Document origin (optional — lets a stored page play its own videos) ──────
# A stored document is framed from an origin of its OWN, so it can be served
# without the `sandbox` that our own origin must impose. That sandbox is what
# stops an embedded YouTube player from drawing (no frame-src, and an opaque
# origin where the player needs a real one), and the one flag that would fix it —
# allow-same-origin — would put agent-authored HTML on our origin. Two hosts is
# the only safe fix, and origin separation is a stronger guarantee than the flag.
#
# Leave everything blank and NOTHING changes: documents keep being served from
# this origin under the sandbox, and the app plays videos beside the page.
#
#   DOCS_ORIGIN=http://localhost:5199   the URL a browser reaches it on
#   DOC_LISTEN_PORT=5199                ALSO serve it from this process
#   DOC_FRAME_ANCESTOR=…                who may embed a document (default: this
#                                       app on PORT). Get it wrong and the frame
#                                       renders blank — the boot log prints it.
#   DOC_TICKET_SECRET=…                 shared HMAC key. REQUIRED when the
#                                       document origin is a SECOND process,
#                                       which on Railway/Fly it always is (one
#                                       exposed port per service).
#
# For local testing set both of the first two; for production run this same file
# as a second service with DOCS_ORIGIN=its own public URL and DOC_LISTEN_PORT=its
# own PORT, and give BOTH processes the same DOC_TICKET_SECRET.
#
# The host must NOT be a subdomain of the app's own domain, or a
# `Domain=.example.com` cookie would be readable by model-authored code.
DOCS_ORIGIN=
DOC_LISTEN_PORT=
DOC_FRAME_ANCESTOR=
DOC_TICKET_SECRET=

# ── Voice dictation (pick ONE; optional — dictation just stays off without it) ─
# Deepgram Nova-3 (recommended: true streaming).
DEEPGRAM_API_KEY=
# OpenAI Whisper (fallback).
OPENAI_API_KEY=

# ── Owner auth (optional) ────────────────────────────────────────────────────
# Google OAuth client ID + the comma-separated emails allowed to own the hub.
GOOGLE_CLIENT_ID=
ALLOWED_EMAILS=

# ── Storage paths (optional overrides) ───────────────────────────────────────
# STATE_FILE=.g2-hub-state.json
# AUTH_FILE=.g2-hub-auth.json
# SECRETS_FILE=.g2-hub-secrets.json
