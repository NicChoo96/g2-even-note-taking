# ─────────────────────────────────────────────────────────────────────────────
# Relay configuration — copy this file to `.env.local` and fill in your keys.
#
#   cp web/.env.example web/.env.local
#
# `.env.local` is GITIGNORED. Real process env vars always win over this file,
# so a host (Railway / Render / Docker) can override anything without editing
# it. Nothing here is ever sent to a client or inlined into a bundle — keys
# stay inside the relay process.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5198

# ── Agents: LLM provider (OpenRouter) ────────────────────────────────────────
# https://openrouter.ai/keys — use free + tool-capable models only.
# NOTE: models must also pass your account's data policy / ZDR guardrail, or
# every run fails with "0 endpoints out of 1 requested are available".
# Working on this account: inclusionai/ling-3.0-flash-sante:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
# Optional OpenRouter attribution headers (required for free-tier routing).
OPENROUTER_REFERER=https://github.com/NicChoo96/g2-even-note-taking
OPENROUTER_TITLE=G2 Even Reality Hub

# ── Agents: web-search tool (Tavily OR Brave Search) ────────────────────────
# The tool is one and the same — the model always calls `web_search` — so pick a
# backend here (or on the Settings page) without touching any agent.
#   SEARCH_PROVIDER=tavily|brave   (leave blank to auto-pick: Tavily if its key
#                                   is set, otherwise Brave)
#   WEB_SEARCH_DEPTH=basic|advanced   default depth for both backends
SEARCH_PROVIDER=
WEB_SEARCH_DEPTH=basic
# Tavily — https://app.tavily.com/home
TAVILY_API_KEY=
# Brave Search — https://api-dashboard.search.brave.com/ (LLM Context plan)
BRAVE_SEARCH_API_KEY=

# ── Voice dictation (pick ONE; optional — dictation just stays off without it) ─
# Deepgram Nova-3 (recommended: true streaming).
DEEPGRAM_API_KEY=
# OpenAI Whisper (fallback).
OPENAI_API_KEY=

# ── Owner auth (optional) ────────────────────────────────────────────────────
# Google OAuth client ID + the comma-separated emails allowed to own the hub.
GOOGLE_CLIENT_ID=
ALLOWED_EMAILS=

# ── Storage paths (optional overrides) ───────────────────────────────────────
# STATE_FILE=.g2-hub-state.json
# AUTH_FILE=.g2-hub-auth.json
# SECRETS_FILE=.g2-hub-secrets.json
